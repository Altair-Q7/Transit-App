# Root-level variables consumed by docker-compose.yml itself (interpolated
# into service definitions with ${VAR}). This is the SINGLE source of truth
# for DB credentials — they used to be duplicated between the mariadb
# service and the backend's DATABASE_URL; now both read from here.
#
# Copy to .env (same folder as docker-compose.yml) and fill in real values
# before running anything beyond local dev:
#   cp .env.example .env

MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=sarathy
MARIADB_USER=sarathy
MARIADB_PASSWORD=change-me-app-password

# How long automated backups are kept before rotation deletes them.
BACKUP_RETENTION_DAYS=7

# Passed straight through to apps/web-admin — must be a browser-reachable
# URL (not the internal "backend" hostname).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
