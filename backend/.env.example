# App
APP_NAME=Sarathy
ENV=development
# Generate a real one with: openssl rand -hex 32
# Startup refuses to boot with this default value when ENV=staging|production.
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (MariaDB - historical source of truth).
# When running via `docker compose up`, this is overridden by the
# DATABASE_URL set directly in docker-compose.yml (built from the root
# .env's MARIADB_* variables) — this line only matters if you run the
# backend outside Docker.
DATABASE_URL=mysql+pymysql://sarathy:sarathy@localhost:3306/sarathy

# Redis (high-frequency live ETA caching + pub/sub for websockets)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# --- Security / production-readiness ---

# Dev convenience: creates tables from SQLAlchemy models on startup.
# MUST be false in staging/production — use `alembic upgrade head` instead.
# (config.py raises at startup if this is true while ENV=staging|production)
AUTO_CREATE_TABLES=true

# Brute-force login lockout: after this many failed attempts for one
# email/phone, further attempts are rejected for LOGIN_LOCKOUT_SECONDS —
# regardless of which IP they come from.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# General per-IP rate limits, format "<count>/<second|minute|hour>".
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
